<dialog id="story-media-lightbox" class="media-lightbox" aria-label="Expanded story media">
	<div class="media-lightbox__stage">
		<figure class="media-lightbox__frame">
			<button class="media-lightbox__close" type="button" aria-label="Close expanded media">
				<span aria-hidden="true">×</span>
			</button>
			<div class="media-lightbox__media"></div>
			<figcaption class="media-lightbox__caption" hidden></figcaption>
		</figure>
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('.media-lightbox');
	const stage = dialog?.querySelector<HTMLElement>('.media-lightbox__stage');
	const mediaContainer = dialog?.querySelector<HTMLElement>('.media-lightbox__media');
	const caption = dialog?.querySelector<HTMLElement>('.media-lightbox__caption');
	const closeButton = dialog?.querySelector<HTMLButtonElement>('.media-lightbox__close');
	const mediaTriggers = document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
		'.cover-frame .cover, .prose figure img, .prose figure video',
	);

	let lastTrigger: HTMLImageElement | HTMLVideoElement | null = null;

	function closeLightbox() {
		if (dialog?.open) dialog.close();
	}

	function openLightbox(trigger: HTMLImageElement | HTMLVideoElement) {
		if (!dialog || !mediaContainer || !caption) return;

		lastTrigger = trigger;
		if (trigger instanceof HTMLVideoElement) trigger.pause();

		const expandedMedia = trigger.cloneNode(true) as HTMLImageElement | HTMLVideoElement;
		expandedMedia.removeAttribute('class');
		expandedMedia.removeAttribute('tabindex');
		expandedMedia.removeAttribute('role');
		expandedMedia.removeAttribute('aria-haspopup');
		expandedMedia.removeAttribute('aria-controls');
		if (expandedMedia instanceof HTMLVideoElement) {
			expandedMedia.controls = true;
			expandedMedia.autoplay = false;
		}

		mediaContainer.replaceChildren(expandedMedia);

		const figureCaption = trigger.closest('figure')?.querySelector('figcaption')?.textContent?.trim();
		caption.textContent = figureCaption || '';
		caption.hidden = !figureCaption;

		dialog.showModal();
		closeButton?.focus();
	}

	mediaTriggers.forEach((trigger) => {
		trigger.tabIndex = 0;
		trigger.setAttribute('aria-haspopup', 'dialog');
		trigger.setAttribute('aria-controls', 'story-media-lightbox');
		if (trigger instanceof HTMLImageElement) trigger.setAttribute('role', 'button');

		trigger.addEventListener('click', (event) => {
			event.preventDefault();
			openLightbox(trigger);
		});

		trigger.addEventListener('keydown', (event) => {
			const keyboardEvent = event as KeyboardEvent;
			if (keyboardEvent.key !== 'Enter' && keyboardEvent.key !== ' ') return;
			event.preventDefault();
			openLightbox(trigger);
		});
	});

	closeButton?.addEventListener('click', closeLightbox);
	stage?.addEventListener('click', (event) => {
		if (event.target === stage) closeLightbox();
	});
	dialog?.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		event.preventDefault();
		closeLightbox();
	});
	dialog?.addEventListener('close', () => {
		const expandedVideo = mediaContainer?.querySelector('video');
		expandedVideo?.pause();
		mediaContainer?.replaceChildren();
		lastTrigger?.focus();
	});
</script>

<style>
	.media-lightbox {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: hidden;
	}

	.media-lightbox::backdrop { background: rgba(78, 78, 78, 0.82); }

	.media-lightbox__stage {
		display: grid;
		width: 100%;
		height: 100%;
		padding: clamp(1.25rem, 4vw, 3.5rem);
		place-items: center;
		cursor: zoom-out;
	}

	.media-lightbox__frame {
		position: relative;
		width: fit-content;
		max-width: 100%;
		margin: 0;
		padding: 0.7rem;
		background: var(--white);
		box-shadow: 0 22px 70px rgba(0, 0, 0, 0.38);
		cursor: default;
	}

	.media-lightbox__media { display: grid; place-items: center; }

	.media-lightbox__media :global(img),
	.media-lightbox__media :global(video) {
		display: block;
		width: auto;
		max-width: min(88vw, 1400px);
		height: auto;
		max-height: calc(100dvh - 8rem);
		margin: 0;
		object-fit: contain;
		background: #202a27;
	}

	.media-lightbox__caption {
		max-width: 760px;
		margin: 0.75rem auto 0.2rem;
		padding: 0 0.75rem;
		color: var(--muted);
		font-size: 0.9rem;
		font-style: italic;
		text-align: center;
	}

	.media-lightbox__close {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 1;
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid #aaa;
		border-radius: 50%;
		background: #eee;
		box-shadow: 0 5px 16px rgba(0, 0, 0, 0.22);
		color: #737373;
		font: 400 2rem/1 Arial, sans-serif;
		place-items: center;
		transform: translate(42%, -42%);
		cursor: pointer;
	}

	.media-lightbox__close:hover { background: #ddd; color: #555; }
	.media-lightbox__close:focus-visible { outline: 3px solid var(--yellow); outline-offset: 3px; }

	@media (max-width: 600px) {
		.media-lightbox__stage { padding: 1rem; }
		.media-lightbox__frame { padding: 0.4rem; }
		.media-lightbox__media :global(img),
		.media-lightbox__media :global(video) { max-width: calc(100vw - 2.8rem); max-height: calc(100dvh - 6rem); }
		.media-lightbox__close { right: 0.25rem; transform: translate(20%, -35%); }
	}
</style>
