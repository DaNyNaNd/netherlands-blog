---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import tulipsPaper from '../assets/journal/tulips-paper.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MediaLightbox from '../components/MediaLightbox.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, coverImage, coverAlt, locations } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={title} description={description} image={coverImage} /></head>
	<body>
		<Header />
		<main class="post">
			<article>
				<header class="post-header">
					<div class="post-kicker">
						<p class="eyebrow">A note from the Netherlands</p>
						<p class="date"><FormattedDate date={pubDate} /></p>
					</div>
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					{locations.length > 0 && <p class="locations">{locations.join(' · ')}</p>}
					{updatedDate && <p class="updated">Updated <FormattedDate date={updatedDate} /></p>}
					<Image src={tulipsPaper} alt="" aria-hidden="true" width={190} />
				</header>
				{coverImage && (
					<figure class="cover-frame">
						<img class="cover" src={coverImage} alt={coverAlt || ''} />
					</figure>
				)}
				<div class="prose"><slot /></div>
				<footer class="story-end">
					<p>Thanks for following along with our Netherlands chapter.</p>
					<a href="/blog">Back to the journal</a>
				</footer>
			</article>
		</main>
		<MediaLightbox />
		<Footer />
	</body>
</html>

<style>
	.post { width: min(920px, calc(100% - 2.5rem)); margin: auto; padding: 5rem 0 6rem; }
	.post-header { position: relative; max-width: 800px; margin: 0 auto 3.5rem; padding: 0 1rem 2.5rem; text-align: center; border-bottom: 3px solid var(--blue); }
	.post-kicker { display: flex; align-items: baseline; justify-content: center; gap: 1rem; }
	.post-kicker p { margin-bottom: 0.8rem; }
	.date, .locations, .updated { color: var(--muted); font-size: 0.9rem; }
	.date { font-weight: 700; }
	.post-header h1 { color: var(--coral); }
	.dek { max-width: 660px; margin: 1.3rem auto 0; color: var(--muted); font-size: 1.25rem; }
	.locations { margin: 1.25rem 0 0; color: var(--blue); font-style: italic; }
	.updated { margin-top: 0.25rem; font-style: italic; }
	.post-header img { position: absolute; right: -10rem; bottom: -2rem; width: 160px; padding: 0.4rem; background: var(--white); box-shadow: 0 10px 28px rgba(43, 36, 27, 0.12); transform: rotate(3deg); }
	.cover-frame { margin: 0 auto 3.5rem; padding: 0.7rem; background: var(--white); box-shadow: var(--shadow); transform: rotate(-0.5deg); }
	.cover { width: 100%; max-height: 620px; object-fit: cover; }
	.prose { width: min(720px, 100%); margin: auto; color: #2c423b; }
	.prose :global(p) { margin: 0 0 1.4rem; }
	.prose :global(h2) { margin: 3.2rem 0 1rem; color: var(--ink-blue); font-size: clamp(2rem, 4vw, 2.8rem); }
	.prose :global(h3) { margin: 2.4rem 0 0.8rem; color: var(--ink-blue); }
	.prose :global(img) { width: 100%; margin: 2.5rem 0 0.7rem; padding: 0.55rem; background: var(--white); box-shadow: 0 12px 32px rgba(43, 36, 27, 0.13); }
	.prose :global(figure) { margin: 2.5rem 0; }
	.prose :global(figure img) { margin: 0; }
	.prose :global(figcaption) { margin-top: 0.7rem; color: var(--muted); font-size: 0.9rem; font-style: italic; text-align: center; }
	.prose :global(video) { display: block; width: 100%; margin: 2.5rem 0; border: 0.55rem solid var(--white); background: var(--ink); box-shadow: 0 12px 32px rgba(43, 36, 27, 0.13); }
	.prose :global(.media-group) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; align-items: start; margin: 2.5rem 0 3rem; }
	.prose :global(.media-group--three) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.prose :global(.media-group .media-figure) { min-width: 0; margin: 0; }
	.prose :global(.media-figure) { break-inside: avoid; }
	.prose :global(.media-figure img), .prose :global(.media-figure video) { margin: 0; }
	.prose :global(.media-group img), .prose :global(.media-group video) { aspect-ratio: 4 / 3; object-fit: cover; }
	.prose :global(.media-figure--feature) { grid-column: 1 / -1; }
	.prose :global(.media-figure--compact) { width: min(100%, 420px); margin: 2.5rem auto 3rem; }
	.cover,
	.prose :global(figure img),
	.prose :global(figure video) { cursor: zoom-in; }
	.cover:focus-visible,
	.prose :global(figure img:focus-visible),
	.prose :global(figure video:focus-visible) { outline: 3px solid var(--yellow); outline-offset: 4px; }
	.prose :global(a) { font-weight: 700; }
	.story-end { width: min(720px, 100%); margin: 4rem auto 0; padding: 2rem; border-top: 3px solid var(--yellow); color: var(--muted); text-align: center; }
	.story-end p { font-family: var(--font-display); font-size: 1.25rem; font-style: italic; }
	.story-end a { font-weight: 700; }

	@media (max-width: 850px) {
		.post-header img { display: none; }
	}

	@media (max-width: 700px) {
		.post { width: min(100% - 1.5rem, 920px); padding-top: 3.2rem; }
		.post-kicker { display: block; }
		.cover-frame { padding: 0.4rem; transform: none; }
		.prose :global(.media-group), .prose :global(.media-group--three) { grid-template-columns: 1fr; gap: 1.75rem; }
		.prose :global(.media-figure--feature) { grid-column: auto; }
	}
</style>
