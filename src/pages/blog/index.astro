---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={`Journal | ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">The journal</p>
			<h1>Stories from our new home.</h1>
			{
				posts.length ? (
					<div class="entries">
						{posts.map((post) => (
							<article>
								{post.data.coverImage && <img src={post.data.coverImage} alt={post.data.coverAlt || ''} />}
								<div>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
									<p>{post.data.description}</p>
									{post.data.locations.length > 0 && <p class="location">{post.data.locations.join(' · ')}</p>}
								</div>
							</article>
						))}
					</div>
				) : <p class="empty-state">No stories are published yet. The first one will appear here soon.</p>
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: min(900px, calc(100% - 2rem)); margin: auto; padding: 4rem 0 5rem; }
	.eyebrow, .date { color: var(--accent); font-size: 0.88rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
	h1 { margin-bottom: 3rem; }
	.entries { display: grid; gap: 2rem; }
	.entries article { display: grid; grid-template-columns: 240px 1fr; gap: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
	.entries img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.75rem; }
	h2 { font-size: 1.8rem; } h2 a { color: var(--ink); text-decoration: none; } h2 a:hover { color: var(--accent); }
	.entries article p:not(.date):not(.location), .empty-state { color: var(--muted); }
	.location { font-size: 0.9rem; font-style: italic; }
	@media (max-width: 600px) { main { padding-top: 2.5rem; } .entries article { grid-template-columns: 1fr; gap: 1rem; } }
</style>
