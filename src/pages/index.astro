---
import { Image } from 'astro:assets';
import canalBicycle from '../assets/journal/canal-bicycle.png';
import rainyCanal from '../assets/journal/rainy-canal.png';
import stroopwafel from '../assets/journal/stroopwafel.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
const latestHref = latestPosts[0] ? `/blog/${latestPosts[0].id}/` : '/blog';
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-heading">
				<div class="hero-copy">
					<p class="eyebrow">A family journal</p>
					<h1 id="hero-heading">Life in the Netherlands, one story at a time.</h1>
					<p class="intro">Photos, videos, and little discoveries from our family’s Dutch chapter.</p>
					<a class="button-link" href={latestHref}>{latestPosts.length ? 'Read our latest story' : 'Visit the journal'}</a>
				</div>

				<div class="hero-collage" aria-label="A scrapbook of Netherlands moments">
					<figure class="photo photo-main">
						<Image src={canalBicycle} alt="A bicycle with a crate of tulips beside an Amsterdam canal" width={720} loading="eager" />
					</figure>
					<figure class="photo photo-rain">
						<Image src={rainyCanal} alt="Warm canal lights seen through a rain-speckled window" width={260} loading="eager" />
					</figure>
					<figure class="photo photo-treat">
						<Image src={stroopwafel} alt="A stroopwafel on a blue and white plate" width={300} loading="eager" />
					</figure>
				</div>
			</section>

			<section class="journal" aria-labelledby="latest-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Notes sent home</p>
						<h2 id="latest-heading">Latest from the journal</h2>
					</div>
					{posts.length > 3 && <a href="/blog">View all stories</a>}
				</div>
				{
					latestPosts.length ? (
						<div class="cards">
							{latestPosts.map((post) => (
								<article class="card">
									{post.data.coverImage && (
										<a class="card-image" href={`/blog/${post.id}/`}>
											<img src={post.data.coverImage} alt={post.data.coverAlt || ''} />
										</a>
									)}
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
									<p>{post.data.description}</p>
									{post.data.locations.length > 0 && <p class="location">{post.data.locations.join(' · ')}</p>}
								</article>
							))}
						</div>
					) : (
						<div class="empty-state paper-panel">
							<div>
								<p class="eyebrow">The next page is blank</p>
								<h3>Our first Netherlands story is on its way.</h3>
								<p>This is where our latest outings, rainy afternoons, favorite foods, photos, and videos will gather.</p>
							</div>
							<a href="/about">Why we made this journal</a>
						</div>
					)
				}
			</section>

			<aside class="mission" aria-label="About this journal">
				<p class="mission-note">Sending a little piece of our day to you.</p>
				<p>We’re cataloging the everyday magic of life in the Netherlands for our family back home in the United States.</p>
			</aside>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { overflow: hidden; }
	.hero {
		position: relative;
		width: min(1240px, calc(100% - 2.5rem));
		min-height: 610px;
		margin: auto;
		padding: clamp(2rem, 3vw, 3.5rem) 0 2rem;
		display: grid;
		grid-template-columns: 0.82fr 1.18fr;
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
	}

	.hero-copy { position: relative; z-index: 4; }
	.hero-copy h1 { max-width: 650px; color: var(--coral); font-size: clamp(3rem, 6vw, 4.8rem); }
	.intro { max-width: 520px; margin: 1.4rem 0 1.8rem; color: var(--ink); font-size: 1.25rem; line-height: 1.45; }
	.hero-collage { position: relative; min-height: 520px; }
	.photo { position: absolute; margin: 0; padding: 0.65rem; background: var(--white); box-shadow: var(--shadow); }
	.photo img { width: 100%; height: 100%; object-fit: cover; }
	.photo-main { inset: 1rem 6.5rem 2.5rem 0; z-index: 1; transform: rotate(-1.3deg); }
	.photo-main img { aspect-ratio: 4 / 3; }
	.photo-rain { z-index: 3; top: -2rem; right: 0; width: 31%; transform: rotate(5deg); }
	.photo-rain img { aspect-ratio: 4 / 5; }
	.photo-treat { z-index: 4; right: 1.6rem; bottom: 0; width: 40%; transform: rotate(6deg); }
	.photo-treat img { aspect-ratio: 4 / 3; }

	.hero::after {
		position: absolute;
		inset: auto 0 0;
		height: 3px;
		content: '';
		background: var(--blue);
		transform: rotate(-0.25deg);
	}

	.journal { width: min(1240px, calc(100% - 2.5rem)); margin: auto; padding: 4rem 0 5rem; }
	.section-heading { margin-bottom: 2.5rem; display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
	.section-heading h2 { margin-bottom: 0; color: var(--ink-blue); }
	.section-heading a { font-weight: 700; }
	.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); }
	.card { position: relative; }
	.card:nth-child(2) { transform: translateY(1.5rem); }
	.card-image { display: block; margin-bottom: 1.25rem; padding: 0.45rem; background: var(--white); box-shadow: 0 10px 28px rgba(43, 36, 27, 0.12); }
	.card-image img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
	.card h3 a { color: var(--ink-blue); text-decoration: none; }
	.card h3 a:hover { color: var(--coral-dark); }
	.card > p:not(.date):not(.location) { color: var(--muted); }
	.date { margin-bottom: 0.4rem; color: var(--coral); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
	.location { color: var(--blue); font-size: 0.88rem; font-style: italic; }
	.empty-state { padding: clamp(1.5rem, 4vw, 3rem); display: flex; align-items: end; justify-content: space-between; gap: 2rem; transform: rotate(-0.3deg); }
	.empty-state > div { max-width: 700px; }
	.empty-state h3 { color: var(--ink-blue); font-size: clamp(1.8rem, 3vw, 2.6rem); }
	.empty-state p:not(.eyebrow) { color: var(--muted); }
	.empty-state > a { flex: none; font-weight: 700; }

	.mission {
		width: min(1100px, calc(100% - 2.5rem));
		margin: 0 auto 5rem;
		padding: 1.6rem clamp(1.5rem, 4vw, 3rem);
		display: grid;
		grid-template-columns: minmax(220px, 0.7fr) 1.4fr;
		gap: 2rem;
		align-items: center;
		border: 1px solid rgba(135, 112, 75, 0.22);
		background: var(--paper-deep);
		transform: rotate(0.35deg);
	}
	.mission p { margin: 0; }
	.mission-note { color: var(--blue); font-family: var(--font-display); font-size: 1.25rem; font-style: italic; }

	@media (max-width: 950px) {
		.hero { grid-template-columns: 1fr; padding-top: 4rem; }
		.hero-copy { max-width: 740px; }
		.hero-collage { min-height: 570px; }
		.hero-tulips { display: none; }
	}

	@media (max-width: 720px) {
		.hero, .journal { width: min(100% - 1.5rem, 1240px); }
		.hero { padding: 3rem 0 3.5rem; gap: 3rem; }
		.hero-collage { min-height: 390px; }
		.photo-main { inset: 1rem 3.7rem 2rem 0; }
		.photo-rain { top: 0; width: 30%; }
		.photo-treat { right: 0.5rem; width: 43%; }
		.cards { grid-template-columns: 1fr; gap: 2.5rem; }
		.card:nth-child(2) { transform: none; }
		.empty-state, .section-heading { align-items: flex-start; flex-direction: column; }
		.mission { grid-template-columns: 1fr; gap: 0.75rem; }
	}

	@media (max-width: 470px) {
		.hero-collage { min-height: 310px; }
		.photo { padding: 0.35rem; }
		.photo-main { inset: 0.5rem 2.7rem 1.5rem 0; }
		.photo-rain { width: 31%; }
		.photo-treat { width: 46%; }
	}
</style>
