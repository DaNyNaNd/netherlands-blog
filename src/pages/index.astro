---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">A family journal</p>
				<h1>Life in the Netherlands,<br />one story at a time.</h1>
				<p>
					A place for our family back home to follow along with the everyday discoveries,
					big milestones, photos, and videos that make this chapter ours.
				</p>
			</section>

			<section class="journal" aria-labelledby="latest-heading">
				<div class="section-heading">
					<h2 id="latest-heading">Latest from the journal</h2>
					{posts.length > 3 && <a href="/blog">See all stories</a>}
				</div>
				{
					latestPosts.length ? (
						<div class="cards">
							{latestPosts.map((post) => (
								<article class="card">
									{post.data.coverImage && <img src={post.data.coverImage} alt={post.data.coverAlt || ''} />}
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
									<p>{post.data.description}</p>
								</article>
							))}
						</div>
					) : (
						<div class="empty-state">
							<p>Our first Netherlands story is on its way. Check back soon.</p>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: min(1100px, calc(100% - 2rem)); margin: auto; padding: 5rem 0; }
	.hero { max-width: 760px; padding: 2rem 0 6rem; }
	.eyebrow, .date { color: var(--accent); font-size: 0.88rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
	.hero h1 { max-width: 720px; font-size: clamp(2.6rem, 7vw, 5.4rem); letter-spacing: -0.055em; }
	.hero p:last-child { max-width: 630px; color: var(--muted); font-size: 1.25rem; }
	.section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-bottom: 1px solid var(--line); margin-bottom: 2rem; }
	.section-heading h2 { margin-bottom: 1rem; }
	.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
	.card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.75rem; }
	.card h3 { font-size: 1.5rem; }
	.card h3 a { color: var(--ink); text-decoration: none; }
	.card h3 a:hover { color: var(--accent); }
	.card p:last-child { color: var(--muted); }
	.empty-state { padding: 2rem; border: 1px dashed var(--line); border-radius: 0.75rem; color: var(--muted); }
	@media (max-width: 700px) { main { padding: 2.5rem 0; } .hero { padding-bottom: 4rem; } .cards { grid-template-columns: 1fr; } }
</style>
